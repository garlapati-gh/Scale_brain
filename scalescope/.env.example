# ==============================================================================
# ScaleScope Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local .env file:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Add your OpenRouter API key below.
# 3. WARNING: Never commit .env to version control!
# ==============================================================================

# OpenRouter API Key (Required for Natural Language SQL generation)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Selection (Optional, defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

